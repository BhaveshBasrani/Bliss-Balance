# Bliss Balance Platform Environment Variables

# Firebase Authentication Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bliss-balance.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bliss-balance
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bliss-balance.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Google reCAPTCHA v3 Site Key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Ld_YOUR_RECAPTCHA_V3_SITE_KEY

# Google Apps Script Web App Deployment URL (Synced with Google Sheets & Drive)
NEXT_PUBLIC_APPSCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_DEPLOYMENT_ID/exec

# Google Drive Folder ID for Footwear Media
NEXT_PUBLIC_DRIVE_FOLDER_ID=1_BlissBalance_Footwear_Drive_Folder_ID
